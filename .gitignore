# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/
*.egg

# Env
.env
# Timestamped .env backups, as created by the hardening runbook in
# docs/SECURITY_HARDENING.md. These hold live secrets.
.env.bak
.env.bak.*
.env.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# Docker volumes
data/

# Local dev compose overrides (published DB/Redis ports, --reload, source mounts).
# MUST NOT exist on a server — see docker-compose.override.yml.example.
docker-compose.override.yml

# pytest
.pytest_cache/
htmlcov/
.coverage

# Alembic
*.pyc

# Python virtualenv
.venv/

# Celery beat runtime state
celerybeat-schedule
celerybeat-schedule.*

# Host-side lock used by the maintenance operator CLI
.maintenance.lock

# Local test/dev vault storage (encrypted upload fixtures)
.tmp_vault/
.vault_dev/

# TypeScript incremental build info (regenerated by `tsc -b`)
*.tsbuildinfo

